rules_version = '2';

// A school's login (Firebase uid) owns schools/{uid} and everything under it (members, ...).
// Nobody else can read or write it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /schools/{schoolId} {
      allow create: if request.auth != null
                    && request.auth.uid == schoolId
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if request.auth != null && request.auth.uid == schoolId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == schoolId;
      }
    }
  }
}
