<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/RoadReady.uss" />
    <ui:VisualElement class="screen">
        <ui:Label text="GERAYO AMAHORO - ARRIVE SAFELY" class="eyebrow" />
        <ui:Label name="title" class="title" />
        <ui:VisualElement class="card grow">
            <ui:Label name="body" class="body" style="font-size: 36px;" />
        </ui:VisualElement>
        <ui:VisualElement class="row">
            <ui:Label name="counter" class="muted" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="back" text="Back" class="btn btn--ghost" />
            <ui:Button name="next" text="Next" class="btn btn--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
