<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/RoadReady.uss" />
    <ui:VisualElement class="screen" style="align-items: center;">
        <ui:Label text="Paused" class="title" />
        <ui:Label name="context" class="subtitle" />
        <ui:VisualElement class="col" style="width: 760px;">
            <ui:Button name="resume" text="Resume" class="btn btn--primary" />
            <ui:Button name="recenter" text="Recenter view" class="btn" />
            <ui:Button name="restart" text="Restart attempt" class="btn" />
            <ui:Button name="skip-tutorial" text="Skip tutorial" class="btn" />
            <ui:Button name="comfort" text="Comfort settings" class="btn" />
            <ui:Button name="quit" text="Quit to menu" class="btn btn--ghost" />
            <ui:Button name="withdraw" text="Withdraw from study" class="btn btn--ghost btn--small" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
