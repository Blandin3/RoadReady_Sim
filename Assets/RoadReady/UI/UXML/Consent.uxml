<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/RoadReady.uss" />
    <ui:VisualElement class="screen">
        <ui:Label text="INFORMED CONSENT" class="eyebrow" />
        <ui:Label text="Before we start" class="title" />
        <ui:ScrollView class="card consent__text">
            <ui:Label name="consent-text" class="body" />
        </ui:ScrollView>
        <ui:VisualElement class="consent__checks">
            <ui:Toggle name="age-ok" text="I am 16 or older (if under 18, my parent or guardian agrees)." />
            <ui:Toggle name="health-ok" text="I have no seizure disorder or severe motion sickness." />
            <ui:Toggle name="understand" text="I understand I can stop or withdraw at any time." />
        </ui:VisualElement>
        <ui:VisualElement class="spacer" />
        <ui:VisualElement class="row row--end consent__actions">
            <ui:Button name="decline" text="I do not agree" class="btn btn--ghost" />
            <ui:Button name="agree" text="I agree to take part" class="btn btn--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
