    - group: ns
      state: 0
    - group: ped
      state: 0
  - name: EW amber
    duration: 3
    states:
    - group: ew
      state: 1
    - group: ns
      state: 0
    - group: ped
      state: 0
  - name: All red
    duration: 2
    states:
    - group: ew
      state: 0
    - group: ns
      state: 0
    - group: ped
      state: 0
  - name: NS green + walk
    duration: 12
    states:
    - group: ew
      state: 0
    - group: ns
      state: 2
    - group: ped
      state: 2
  - name: Walk ending
    duration: 4
    states:
    - group: ew
      state: 0
    - group: ns
      state: 2
    - group: ped
      state: 1
  - name: NS amber
    duration: 3
    states:
    - group: ew
      state: 0
    - group: ns
      state: 1
    - group: ped
      state: 0
  - name: All red
    duration: 2
    states:
    - group: ew
      state: 0
    - group: ns
      state: 0
    - group: ped
      state: 0
  m_StartOffset: 0
  m_Running: 1
